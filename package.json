{
  "name": "dsh-pet-astra-yao",
  "version": "0.1.6",
  "description": "Astra Yao — a Codex v2 sprite-atlas desktop pet for DeepSeek Harness, with session-state animation, a status bubble and a DeepSeek balance readout",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./atlas": "./src/atlas.js",
    "./config": "./src/config.js",
    "./state": "./src/state.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "lib/client.js",
    "assets/icon-180.png",
    "spritesheet.webp",
    "pet.json",
    "cordis.patch.yml",
    "README.md",
    "USAGE.md"
  ],
  "scripts": {
    "build:atlas": "node scripts/pack-atlas.mjs",
    "build": "node scripts/build-client.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "node --test \"test/*.test.js\"",
    "test:atlas": "python -B test/audit_atlas_test.py",
    "prepare": "node scripts/build-client.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "codex-pet",
    "astra-yao"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hongxin-y/codex-pet-Astra-Yao.git"
  },
  "homepage": "https://github.com/hongxin-y/codex-pet-Astra-Yao#readme",
  "bugs": {
    "url": "https://github.com/hongxin-y/codex-pet-Astra-Yao/issues"
  },
  "license": "UNLICENSED",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <4.0.5-0 || >=4.0.5-0 <5.0.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <3.18.5-0 || >=3.18.5-0 <4.0.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "devDependencies": {
    "sharp": "0.35.5"
  }
}
